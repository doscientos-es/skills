{
  "name": "@doscientos/changelog",
  "version": "0.1.0",
  "description": "CLI sin dependencias para changelogs incrementales desde Git y exportacion JSON",
  "scripts": {
    "test": "node --test test/changelog.test.mjs",
    "prepack": "node scripts/prepare-package.mjs",
    "release:check": "npm test && node test/package.test.mjs"
  },
  "keywords": [
    "changelog",
    "git",
    "release-notes",
    "agent-skill",
    "product"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "changelog": "bin/changelog.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@9.15.2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/doscientos-es/skills.git"
  },
  "files": [
    "bin/changelog.mjs",
    "SKILL.md",
    "README.md",
    "LICENSE"
  ]
}
